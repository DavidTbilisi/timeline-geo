{
  "name": "timeline-geo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:example": "vite -c examples/minimal/vite.config.ts",
    "build": "npm run build:app",
    "build:app": "vue-tsc -b && vite build",
    "build:lib": "rimraf dist && vite build -c vite.lib.config.ts && vue-tsc -p tsconfig.lib.json && rimraf dist/styles.js dist/styles.js.map",
    "build:example": "vite build -c examples/minimal/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.lib.json && vue-tsc --noEmit -p tsconfig.example.json",
    "check:boundaries": "node scripts/check-lib-boundaries.mjs",
    "preview": "vite preview",
    "extract": "node scripts/extractEvents.mjs",
    "fetch:details": "node scripts/fetchDetails.mjs",
    "fetch:images": "node scripts/fetchImages.mjs",
    "fetch:fonts": "node scripts/fetchFonts.mjs",
    "translate:export": "node scripts/translateDetails.mjs --export",
    "translate:import": "node scripts/translateDetails.mjs --import",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "prepublishOnly": "npm run check:boundaries && npm run test:unit && npm run build:lib && publint",
    "test:example": "playwright test -c playwright.example.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.0",
    "autoprefixer": "^10.4.0",
    "happy-dom": "^20.14.0",
    "node-html-parser": "^6.1.0",
    "pinia": "^2.2.0",
    "postcss": "^8.4.0",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^5.0.0",
    "vue": "^3.5.30",
    "vue-i18n": "^9.13.0",
    "vue-router": "^4.3.0",
    "vue-tsc": "^3.2.5"
  },
  "description": "Config-driven horizontal timeline engine for Vue 3: periods with their own scales, auto-layout of events from years, localized content, pluggable detail tabs.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "timeline",
    "vue",
    "vue3",
    "history",
    "chronology",
    "visualization"
  ],
  "peerDependencies": {
    "pinia": "^2.1.0 || ^3.0.0",
    "vue": "^3.4.0",
    "vue-i18n": "^9.13.0 || ^10.0.0 || ^11.0.0",
    "vue-router": "^4.3.0"
  }
}
